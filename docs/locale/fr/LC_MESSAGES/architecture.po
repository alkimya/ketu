msgstr "Package Ephemeris"

#: ../../source/architecture.md:57
msgid "Time Conversions (ephemeris/time.py)"
msgstr "Conversions de temps (ephemeris/time.py)"

#: ../../source/architecture.md:59
msgid "Handles all time-related calculations:"
msgstr "Gère tous les calculs liés au temps :"

#: ../../source/architecture.md:61
msgid "**UTC ↔ Julian Day** conversions"
msgstr "Conversions **UTC ↔ Jour Julien**"

#: ../../source/architecture.md:62
msgid "**Equation of time** calculations"
msgstr "Calculs de l'**équation du temps**"

#: ../../source/architecture.md:63
msgid "**Sidereal time** calculations"
msgstr "Calculs du **temps sidéral**"

#: ../../source/architecture.md:64
msgid "**Delta T** corrections for historical dates"
msgstr "Corrections **Delta T** pour les dates historiques"

#: ../../source/architecture.md:66
msgid "Uses purely mathematical formulas - no external dependencies."
msgstr "Utilise des formules purement mathématiques - pas de dépendances externes."

#: ../../source/architecture.md:68
msgid "Orbital Mechanics (ephemeris/orbital.py)"
msgstr "Mécanique orbitale (ephemeris/orbital.py)"

#: ../../source/architecture.md:70
msgid "Core astronomical calculations:"
msgstr "Calculs astronomiques principaux :"

#: ../../source/architecture.md:72
msgid "**Kepler solver** - Solves Kepler's equation using Newton-Raphson"
msgstr "**Solveur de Kepler** - Résout l'équation de Kepler par Newton-Raphson"

#: ../../source/architecture.md:73
msgid "**Orbital elements** - Planetary orbital parameters"
msgstr "**Éléments orbitaux** - Paramètres orbitaux planétaires"

#: ../../source/architecture.md:74
msgid "**Perturbations** - Major planetary perturbations"
msgstr "**Perturbations** - Perturbations planétaires majeures"

#: ../../source/architecture.md:75
msgid "**Position from elements** - Convert orbital elements to position"
msgstr "**Position depuis éléments** - Convertir éléments orbitaux en position"

#: ../../source/architecture.md:77
msgid "Coordinate Transformations (ephemeris/coordinates.py)"
msgstr "Transformations de coordonnées (ephemeris/coordinates.py)"

#: ../../source/architecture.md:79
msgid "Coordinate system conversions:"
msgstr "Conversions de systèmes de coordonnées :"

#: ../../source/architecture.md:81
msgid "**Ecliptic ↔ Equatorial** coordinates"
msgstr "Coordonnées **Écliptiques ↔ Équatoriales**"

#: ../../source/architecture.md:82
msgid "**Heliocentric ↔ Geocentric** positions"
msgstr "Positions **Héliocentriques ↔ Géocentriques**"

#: ../../source/architecture.md:83
msgid "**Rectangular ↔ Spherical** coordinates"
msgstr "Coordonnées **Rectangulaires ↔ Sphériques**"

#: ../../source/architecture.md:84
msgid "**Nutation** corrections"
msgstr "Corrections de **nutation**"

#: ../../source/architecture.md:85
msgid "**Aberration** corrections"
msgstr "Corrections d'**aberration**"

