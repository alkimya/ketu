msgid "Planetary Calculations (ephemeris/planets.py)"
msgstr "Calculs planétaires (ephemeris/planets.py)"

#: ../../source/architecture.md:89
msgid "High-level planetary position functions:"
msgstr "Fonctions de position planétaire de haut niveau :"

#: ../../source/architecture.md:91
msgid "`calc_planet_position()` - Single date calculation"
msgstr "`calc_planet_position()` - Calcul pour une date unique"

#: ../../source/architecture.md:92
msgid "`calc_planet_position_batch()` - Vectorized batch calculation"
msgstr "`calc_planet_position_batch()` - Calcul batch vectorisé"

#: ../../source/architecture.md:93
msgid "`find_exact_aspect()` - Binary search for exact aspects"
msgstr "`find_exact_aspect()` - Recherche binaire pour aspects exacts"

#: ../../source/architecture.md:94
msgid "`body_properties()` - Get full position + velocity"
msgstr "`body_properties()` - Obtenir position complète + vélocité"

#: ../../source/architecture.md:96
msgid "Advanced Features"
msgstr "Fonctionnalités avancées"

#: ../../source/architecture.md:98
msgid "Aspect Windows (aspect_windows.py)"
msgstr "Fenêtres d'aspects (aspect_windows.py)"

#: ../../source/architecture.md:100
msgid "Temporal tracking of aspects:"
msgstr "Suivi temporel des aspects :"

#: ../../source/architecture.md:102
msgid "**AspectMoment** - Instant when aspect is exact"
msgstr "**AspectMoment** - Instant où l'aspect est exact"

#: ../../source/architecture.md:103
msgid "**AspectWindow** - Duration from begin to end of aspect"
msgstr "**AspectWindow** - Durée du début à la fin de l'aspect"

#: ../../source/architecture.md:104
msgid "`find_aspect_window()` - Find all windows in date range"
msgstr "`find_aspect_window()` - Trouver toutes les fenêtres dans une période"

#: ../../source/architecture.md:105
msgid "`find_aspects_timeline()` - Complete aspect timeline"
msgstr "`find_aspects_timeline()` - Chronologie complète des aspects"

#: ../../source/architecture.md:107
msgid "Uses binary search and gradient descent for precision."
msgstr "Utilise recherche binaire et descente de gradient pour la précision."

#: ../../source/architecture.md:109
msgid "Transits (transits.py)"
msgstr "Transits (transits.py)"

#: ../../source/architecture.md:111
msgid "Natal position and transit calculations:"
msgstr "Calculs de positions natales et de transits :"

#: ../../source/architecture.md:113
msgid "**NatalPosition** - Stores natal planet position"
msgstr "**NatalPosition** - Stocke la position natale de planète"

#: ../../source/architecture.md:114
msgid "**TransitAspect** - Describes transit-to-natal aspect"
msgstr "**TransitAspect** - Décrit l'aspect transit vers natal"

#: ../../source/architecture.md:115
msgid "`get_natal_positions()` - Extract natal positions"
msgstr "`get_natal_positions()` - Extraire les positions natales"

#: ../../source/architecture.md:116
msgid "`find_transits_to_position()` - Find transits to a point"
msgstr "`find_transits_to_position()` - Trouver les transits vers un point"

#: ../../source/architecture.md:117
msgid "`compare_dates_transits()` - Full transit comparison"
msgstr "`compare_dates_transits()` - Comparaison complète de transits"

#: ../../source/architecture.md:119
msgid "Ephemeris Cache (cache/)"
msgstr "Cache d'éphémérides (cache/)"

#: ../../source/architecture.md:121
msgid "High-performance position lookups:"
msgstr "Recherches de positions haute performance :"

#: ../../source/architecture.md:123
msgid "**EphemerisCache** - Monthly pre-computed positions for O(1) lookups"
msgstr "**EphemerisCache** - Positions pré-calculées mensuellement pour recherches O(1)"

#: ../../source/architecture.md:124
msgid "`ensure_month()` - Pre-compute and cache a month of positions"
msgstr "`ensure_month()` - Pré-calculer et mettre en cache un mois de positions"

#: ../../source/architecture.md:125
msgid "`get_position()` - Fast position lookup with interpolation"
msgstr "`get_position()` - Recherche rapide de position avec interpolation"

#: ../../source/architecture.md:126
msgid "`get_all_positions()` - Batch position retrieval for all bodies"
msgstr "`get_all_positions()` - Récupération batch de positions pour tous les corps"

#: ../../source/architecture.md:127
msgid ""
"**Performance**: 1000x faster than computation (0.006ms vs 10ms per "
"lookup)"
msgstr ""
"**Performance** : 1000x plus rapide que le calcul (0.006ms vs 10ms par recherche)"

