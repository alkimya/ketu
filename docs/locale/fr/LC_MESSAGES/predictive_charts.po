msgid "lunar_return"
msgstr "lunar_return"

#: ../../source/predictive_charts.md:71
msgid "`natal_lat`, `natal_lon` — natal location"
msgstr "`natal_lat`, `natal_lon` — emplacement natal"

#: ../../source/predictive_charts.md:72
msgid ""
"`target_jd` — Julian Day to start the search from (float); the function "
