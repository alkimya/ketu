msgstr ""
"`return_lat`, `return_lon` — coordonnées de relocalisation (voir ci-"
"dessous) ; défaut `None` = emplacement natal"

#: ../../source/predictive_charts.md:36
msgid "`system` — house system for the return chart (default `\"placidus\"`)"
msgstr "`system` — système de maisons pour le thème de retour (défaut `\"placidus\"`)"

