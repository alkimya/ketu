msgstr "Points fictifs"

#: ../../source/concepts.md:60
msgid "**Rahu** ☊ (body_id=10): Mean North Node"
msgstr "**Rahu** ☊ (body_id=10) : Nœud moyen Nord"

#: ../../source/concepts.md:61
