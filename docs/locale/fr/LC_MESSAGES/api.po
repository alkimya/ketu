msgid "`utc_to_julian(dtime)`"
msgstr "`utc_to_julian(dtime)`"

#: ../../source/api.md:222
msgid "Convert a UTC datetime to Julian Day number."
msgstr "Convertit un datetime UTC en numéro de Jour Julien."

#: ../../source/api.md:224
msgid ""
"**Parameters:** `dtime` (`datetime`): UTC datetime (timezone-aware or "
"naive UTC)"
msgstr ""
"**Paramètres :** `dtime` (`datetime`) : datetime UTC (avec ou sans "
"information de fuseau horaire)"

#: ../../source/api.md:236
msgid "`local_to_utc(dtime, zoneinfo=None)`"
msgstr "`local_to_utc(dtime, zoneinfo=None)`"

#: ../../source/api.md:238
msgid "Convert a local datetime to UTC."
msgstr "Convertit un datetime local en UTC."

#: ../../source/api.md:241
msgid "`dtime` (`datetime`): local datetime with or without tzinfo"
msgstr "`dtime` (`datetime`) : datetime local avec ou sans tzinfo"

#: ../../source/api.md:242
msgid "`zoneinfo` (`ZoneInfo`, optional): timezone if not embedded in dtime"
msgstr ""
"`zoneinfo` (`ZoneInfo`, optionnel) : fuseau horaire si non intégré dans "
"dtime"

#: ../../source/api.md:244
msgid "**Returns:** `datetime` in UTC"
msgstr "**Retourne :** `datetime` en UTC"

