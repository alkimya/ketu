msgid "`calculate_aspects(jdate, l_bodies=bodies, aspects=None)`"
msgstr "`calculate_aspects(jdate, l_bodies=bodies, aspects=None)`"

#: ../../source/api.md:285
msgid "Compute all in-orb aspects for the given date."
msgstr "Calcule tous les aspects dans l'orbe pour la date donnée."

#: ../../source/api.md:288
