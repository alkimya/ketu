msgstr ""
"**Paramètres :** `dtime` (`datetime`) : datetime UTC (avec ou sans "
"information de fuseau horaire)"

#: ../../source/api.md:236
msgid "`local_to_utc(dtime, zoneinfo=None)`"
msgstr "`local_to_utc(dtime, zoneinfo=None)`"

#: ../../source/api.md:238
msgid "Convert a local datetime to UTC."
msgstr "Convertit un datetime local en UTC."

